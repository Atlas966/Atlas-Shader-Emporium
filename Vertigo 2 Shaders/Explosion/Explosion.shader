				float3 Emission = 0;
#if 0
				float3 BakedEmission = 0;
#endif
				float3 Specular = 0.5;
				float Metallic = (float)0;
				float Smoothness = (float)0;
				float Occlusion = 1;
				float Alpha = smoothstepResult96;
				float AlphaClipThreshold = 0.5;
				float AlphaClipThresholdShadow = 0.5;
