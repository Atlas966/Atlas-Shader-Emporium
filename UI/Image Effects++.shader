				float sin21 = sin(  (0.0 + ( _GradientRotation - 0.0 ) * ( 6.5 - 0.0 ) / ( 1.0 - 0.0 ) ) );
				float2 rotator21 = mul( texCoord68 - float2( 0.5,0.5 ) , float2x2( cos21 , -sin21 , sin21 , cos21 )) + float2( 0.5,0.5 );
