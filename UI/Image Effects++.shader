				float2 uv_NoiseDistortionOffsetScroll = IN.ase_texcoord3.xy * _NoiseDistortionOffsetScroll_ST.xy + _NoiseDistortionOffsetScroll_ST.zw;
				float2 UV1_g6 = ( float4( uv_MainTex, 0.0 , 0.0 ) + ( SAMPLE_TEXTURE2D( _NoiseDistortionOffsetScroll, sampler_NoiseDistortionOffsetScroll, ( uv_NoiseDistortionOffsetScroll + ( _NoiseDistortionOffsetScroll_ST.zw * _TimeParameters.x ) ) ) * _NoiseDistortionAmount ) ).rg;
				float _Blur_Instance = UNITY_ACCESS_INSTANCED_PROP(AtlasShadersUIImageEffects,_Blur);
