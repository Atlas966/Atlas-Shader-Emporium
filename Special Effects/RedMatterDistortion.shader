				float3 ase_viewDirWS = normalize( ase_viewVectorWS );
				float3 ase_normalWS = i.ase_texcoord7.xyz;
				float dotResult585 = dot( ase_viewDirWS , ase_normalWS );
				float2 uv_Normal = i.uv0XY_bitZ_fog.xy * _Normal_ST.xy + _Normal_ST.zw;
				float3 unpack597 = UnpackNormalScale( tex2D( _Normal, uv_Normal ), _DistortionAmount );
				unpack597.z = lerp( 1, unpack597.z, saturate(_DistortionAmount) );
				float3 Normal619 = unpack597;
				float4 screenPos = i.ase_texcoord8;
				float ase_depthLinearEye = LinearEyeDepth( screenPos.z / screenPos.w, _ZBufferParams );
				float4 ase_positionSSNorm = screenPos / screenPos.w;
				ase_positionSSNorm.z = ( UNITY_NEAR_CLIP_VALUE >= 0 ) ? ase_positionSSNorm.z : ase_positionSSNorm.z * 0.5 + 0.5;
				float depthLinearEye28_g1 = LinearEyeDepth( SHADERGRAPH_SAMPLE_SCENE_DEPTH( ase_positionSSNorm.xy ), _ZBufferParams );
				float2 temp_output_20_0_g1 = ( (Normal619).xy * ( 0.02 / max( ase_depthLinearEye, 0.1 ) ) * saturate( ( depthLinearEye28_g1 - ase_depthLinearEye ) ) );
				float depthLinearEye2_g1 = LinearEyeDepth( SHADERGRAPH_SAMPLE_SCENE_DEPTH( ( float4( temp_output_20_0_g1, 0.0 , 0.0 ) + ase_positionSSNorm ).xy ), _ZBufferParams );
				float2 temp_output_32_0_g1 = (( float4( ( temp_output_20_0_g1 * saturate( ( depthLinearEye2_g1 - ase_depthLinearEye ) ) ), 0.0 , 0.0 ) + ase_positionSSNorm )).xy;
				float4 fetchOpaqueVal509 = float4( SHADERGRAPH_SAMPLE_SCENE_COLOR( ( ( ( 1.0 - dotResult585 ) * _EdgeWarpAmount ) + temp_output_32_0_g1 ).xy ), 1.0 );
				float4 Distortion613 = fetchOpaqueVal509;
				float3 ase_viewDirSafeWS = SafeNormalize( ase_viewVectorWS );
				float3 normalizedWorldNormal = normalize( ase_normalWS );
				float3 viewDirectionWS605 = refract( -ase_viewDirSafeWS , normalizedWorldNormal , _CubemapRefraction );
				float dotResult601 = dot( normalizedWorldNormal , ase_viewDirSafeWS );
				float blur605 = ( 1.0 - saturate( dotResult601 ) );
